{
  "name": "unified-wms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --wms-development",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:edge": "deno check supabase/functions/admin-users/index.ts",
    "supabase:local": "node scripts/local-preflight.mjs",
    "supabase:local:setup": "node scripts/setup-local-env.mjs",
    "test:packing-audit": "node --import tsx --test scripts/packing-audit.test.mjs",
    "test:packing-server-static": "node --test scripts/packing-server-candidate.test.mjs",
    "test:server-scan-rpc": "node --import tsx --test scripts/server-scan-rpc.test.mjs",
    "test:sorting-server": "node --import tsx --test scripts/sorting-server-integration.test.mjs",
    "test:isolated-pg-static": "node --test scripts/isolated-pg-harness.test.mjs",
    "supabase:local:migrations": "node scripts/build-local-migrations.mjs",
    "supabase:local:check": "node --import tsx --test scripts/build-local-migrations.test.mjs scripts/local-safety.test.mjs && node scripts/build-local-migrations.mjs --check && node --import tsx scripts/check-local-seed.mjs",
    "supabase:local:bootstrap-admin": "node scripts/bootstrap-local-admin.mjs",
    "supabase:local:seed": "node --import tsx scripts/seed-local.mjs",
    "supabase:local:recover-documents": "node --import tsx scripts/recover-local-seed-documents.mjs",
    "start": "tsx server.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
